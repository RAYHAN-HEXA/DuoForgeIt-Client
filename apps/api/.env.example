# Copy to .env and fill in real values. NEVER commit the real .env.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Comma-separated allowlist of browser origins that may call this API
CORS_ORIGINS=https://techservicehub.vercel.app

# Canonical admin-panel origin (email CTA links); defaults to the first CORS origin
# ADMIN_PANEL_URL=http://localhost:3000

# Neon PostgreSQL — pooled endpoint for runtime, direct endpoint for Prisma CLI
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
# Preferred: base64 of the service-account JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternative: individual fields from the service-account JSON
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternative: path to the JSON file
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Seed-only founder emails (used by scripts/provision-accounts.ts + seed.ts,
# NOT read by env.ts — the runtime founder recipients are FOUNDER_NOTIFY_EMAILS)
SEED_FOUNDER_A_EMAIL=founder.a@example.test
SEED_FOUNDER_B_EMAIL=founder.b@example.test

# Vercel Blob — private file storage (server-side only, never NEXT_PUBLIC_*)
# Create a PRIVATE Blob store in the Vercel project; Vercel injects this token.
# BLOB_READ_WRITE_TOKEN=

# Mailer — first match wins: RESEND_API_KEY → SMTP_HOST+SMTP_USER+SMTP_PASS → none.
# With `none`, all transactional email is skipped and logged (see /api/health).
# RESEND_API_KEY=
# MAIL_FROM="TechService Hub <you@example.com>"   (default onboarding@resend.dev)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                                   (465 switches nodemailer to secure)
# SMTP_USER=
# SMTP_PASS=                                      (Gmail: app password, spaces OK)
# Comma-separated founder recipients for order/payment alerts
# FOUNDER_NOTIFY_EMAILS=

# Upstash Redis — distributed rate-limit stores (per-limiter). Unset = in-memory
# per serverless instance (health reports redisRateLimiting: false).
# NOTE: the token var is UPSTASH_REDIS_TOKEN (no second REST).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_TOKEN=

# Feature flags — exact string 'true' enables; anything else (incl. unset) is off.
# SERVICE_MARKETPLACE_ENABLED gates /api/marketplace/* + v2 catalog filtering.
# WALLET_ENABLED gates wallet phase (M5+, keep off until it ships).
# Flip together with the web NEXT_PUBLIC_* flags — API first, see
# docs/MARKETPLACE-LAUNCH-RUNBOOK.md.
# SERVICE_MARKETPLACE_ENABLED=false
# WALLET_ENABLED=false
