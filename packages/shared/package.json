{
  "name": "@tsh/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Zod schemas, types, and constants for TechService Hub (consumed by apps/web and apps/api)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
